import Phaser from 'phaser';

export default class MazeChaseScene extends Phaser.Scene {
  constructor() { super('MazeChaseScene'); }

  create() {
    const theme = this.registry.get('theme') || { bg: '#1e1b4b', card: '#6366f1', accent: '#ffffff' };
    const gameData = this.registry.get('gameData') || [
      { id: 1, term: 'Apple', isCorrect: true },
      { id: 2, term: 'Banana', isCorrect: false },
      { id: 3, term: 'Cherry', isCorrect: false }
    ];

    this.cameras.main.setBackgroundColor(theme.bg);
    this.add.text(400, 50, 'Maze Chase: Collect the correct answer!', { fill: theme.accent, fontSize: '24px', fontFamily: 'sans-serif' }).setOrigin(0.5);

    // Physics Setup
    this.player = this.physics.add.sprite(100, 300, 'player').setCircle(20).setCollideWorldBounds(true);
    this.player.setTint(Phaser.Display.Color.HexToColor(theme.card.replace('#', '0x')).color);

    this.cursors = this.input.keyboard.createCursorKeys();
    this.input.on('pointerdown', (p) => this.physics.moveTo(this.player, p.x, p.y, 400));
    this.input.on('pointerup', () => this.player.setVelocity(0, 0));

    // Targets & Enemies
    this.targets = this.physics.add.group();
    
    // Spawn Correct Target
    this.spawnEntity(600, 150, gameData[0].term, 0x10b981, true);
    
    // Spawn Incorrect Targets (Enemies)
    gameData.slice(1).forEach((data, i) => {
      this.spawnEntity(650, 350 + (i * 50), data.term, 0xef4444, false);
    });

    // Collisions
    this.physics.add.overlap(this.player, this.targets, this.handleCollision, null, this);
  }

  spawnEntity(x, y, text, color, isCorrect) {
    const container = this.add.container(x, y);
    const orb = this.add.circle(0, 0, 30, color, 0.3).setStrokeStyle(2, color);
    const label = this.add.text(0, 0, text, { fill: '#fff', fontSize: '16px', fontFamily: 'sans-serif' }).setOrigin(0.5);
    container.add([orb, label]);
    
    const body = this.physics.add.existing(container);
    body.body.setCircle(30).setImmovable(true);
    container.setData('isCorrect', isCorrect);
    container.setData('hit', false);
    
    this.targets.add(container);

    // If it's an enemy, make it chase the player
    if (!isCorrect) {
      this.time.addEvent({
        delay: 1500, loop: true,
        callback: () => {
          if (container.active) this.physics.moveTo(container, this.player.x, this.player.y, 120);
        }
      });
    }
  }

  handleCollision(player, target) {
    if (target.getData('hit')) return;
    target.getData('hit', true);

    const isCorrect = target.getData('isCorrect');
    const color = isCorrect ? 0x10b981 : 0xef4444;

    // AAA Juice
    const emitter = this.add.particles(target.x, target.y, 'particle', {
      speed: 300, lifespan: 800, tint: color, quantity: 30, emitting: false
    });
    emitter.explode(30);
    this.cameras.main.shake(200, isCorrect ? 0.01 : 0.005);

    if (isCorrect) {
      this.add.text(400, 300, 'CORRECT!', { fill: '#10b981', fontSize: '64px', fontFamily: 'sans-serif' }).setOrigin(0.5);
      this.physics.pause();
      this.time.delayedCall(1500, () => this.scene.restart());
    } else {
      // Bounce player back
      this.physics.moveTo(player, 100, 300, 400);
      this.time.delayedCall(200, () => player.setVelocity(0, 0));
      target.destroy(); // Remove enemy after hit
    }
  }

  update() {
    // Keyboard controls
    if (this.cursors.left.isDown) this.player.setVelocityX(-300);
    else if (this.cursors.right.isDown) this.player.setVelocityX(300);
    else if (!this.input.activePointer.isDown) this.player.setVelocityX(0);

    if (this.cursors.up.isDown) this.player.setVelocityY(-300);
    else if (this.cursors.down.isDown) this.player.setVelocityY(300);
    else if (!this.input.activePointer.isDown) this.player.setVelocityY(0);
  }
}